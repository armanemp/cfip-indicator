<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>CFIP.Indicator</AssemblyName>
    <RootNamespace>CFIP.Indicator</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Using Include="CFIP.Indicator.Core" />
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="cAlgo.API" Condition="'$(CFIP_CTRADER_API)' != ''">
      <HintPath>$(CFIP_CTRADER_API)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="cAlgo.API" Condition="'$(CFIP_CTRADER_API)' == ''">
      <HintPath>$(UserProfile)DocumentscAlgoAPIcAlgo.API.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
